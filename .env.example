# --- Supabase ---------------------------------------------------------------
# All database access is server-side through the service-role key. There is
# deliberately no NEXT_PUBLIC_SUPABASE_* pair here: anything NEXT_PUBLIC_ is
# inlined into the browser bundle, and the tables run RLS deny-all, so an anon
# key would be a published credential that grants nothing. Don't add one back
# unless you also write RLS policies for it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=
# Model used for extract + score. Spec calls for claude-sonnet-5.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Meta Ad Library --------------------------------------------------------
META_ACCESS_TOKEN=

# --- Scraping ---------------------------------------------------------------
# adapter selector: scrapingbee | scrapfly | fetch
SCRAPER_PROVIDER=scrapingbee
SCRAPER_API_KEY=

# --- Ops --------------------------------------------------------------------
# Guards /api/cron/* routes. Vercel Cron sends this automatically as
# `Authorization: Bearer $CRON_SECRET` when the env var is named CRON_SECRET.
CRON_SECRET=
DAILY_PAGE_CAP=15
# Junk filter, not a quality bar — Review stars are the quality bar.
# Composite is a weighted 1-5 mean; a decent-but-generic page lands near 2.75.
SCORE_THRESHOLD=2.5

# Optional shared-password gate for the whole app. Leave unset to disable auth.
APP_PASSWORD=
